{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "reference": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "customerEmail": {
      "type": "email",
      "required": true
    },
    "customerName": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "shippingName": {
      "type": "string"
    },
    "shippingPhone": {
      "type": "string"
    },
    "shippingNotes": {
      "type": "text"
    },
    "differentShipping": {
      "type": "boolean",
      "default": false
    },
    "amount": {
      "type": "decimal"
    },
    "items": {
      "type": "json"
    },
    "orderStatus": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "cancelled"
      ]
    },
    "paidAt": {
      "type": "datetime"
    },
    "paystackData": {
      "type": "json"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "orders"
    },
    "products": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "orders"
    }
  }
}