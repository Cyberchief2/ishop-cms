{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Product_Name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "Price": {
      "type": "integer",
      "required": true
    },
    "Description": {
      "type": "blocks"
    },
    "Image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "BookFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "Category": {
      "type": "string"
    },
    "Sub_Type": {
      "type": "string"
    },
    "Type": {
      "type": "string"
    },
    "Specifications": {
      "type": "component",
      "component": "product.specification",
      "repeatable": true
    }
  }
}